{
  "name": "artemis-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "artemisbrowser.app", "custom_domain": true },
    { "pattern": "www.artemisbrowser.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
