<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Artemis Terminology">
	<suite name="Standard Suite" code="????" description="Common classes and commands for all applications.">
		<command name="close" code="coreclos" description="Close a window or a tab.">
			<cocoa class="NSCloseCommand"/>
			<direct-parameter type="specifier" description="The window(s) or tab(s) to close."/>
		</command>
		<command name="quit" code="aevtquit" description="Quit Artemis.">
			<cocoa class="NSQuitCommand"/>
		</command>
		<command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
			<cocoa class="NSCountCommand"/>
			<direct-parameter type="specifier" description="The objects to be counted."/>
			<parameter name="each" code="kocl" type="type" optional="yes" description="The class of objects to be counted." hidden="yes">
				<cocoa key="ObjectClass"/>
			</parameter>
			<result type="integer" description="The count."/>
		</command>
		<command name="exists" code="coredoex" description="Verify that an object exists.">
			<cocoa class="NSExistsCommand"/>
			<direct-parameter type="any" description="The object(s) to check."/>
			<result type="boolean" description="Did the object(s) exist?"/>
		</command>
		<command name="make" code="corecrel" description="Open a new window or tab.">
			<cocoa class="ArtemisMakeCommand"/>
			<parameter name="new" code="kocl" type="type" description="window or tab.">
				<cocoa key="ObjectClass"/>
			</parameter>
			<parameter name="at" code="insh" type="location specifier" optional="yes" description="Where to open it: a window or a space. Defaults to the front browser window.">
				<cocoa key="Location"/>
			</parameter>
			<parameter name="with properties" code="prdt" type="record" optional="yes" description="URL for a tab, mode for a window.">
				<cocoa key="KeyDictionary"/>
			</parameter>
			<result type="specifier" description="The new object."/>
		</command>
		<class name="application" code="capp" description="Artemis.">
			<cocoa class="NSApplication"/>
			<property name="name" code="pnam" type="text" access="r" description="The name of the application."/>
			<property name="frontmost" code="pisf" type="boolean" access="r" description="Is this the active application?">
				<cocoa key="isActive"/>
			</property>
			<property name="version" code="vers" type="text" access="r" description="The version number of the application."/>
			<element type="window" access="r">
				<cocoa key="orderedWindows"/>
			</element>
			<responds-to command="quit">
				<cocoa method="handleQuitScriptCommand:"/>
			</responds-to>
		</class>
		<class name="window" code="cwin" description="A window.">
			<cocoa class="NSWindow"/>
			<property name="name" code="pnam" type="text" access="r" description="The title of the window.">
				<cocoa key="title"/>
			</property>
			<property name="id" code="ID  " type="integer" access="r" description="The unique identifier of the window.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="index" code="pidx" type="integer" description="The index of the window, ordered front to back.">
				<cocoa key="orderedIndex"/>
			</property>
			<property name="bounds" code="pbnd" type="rectangle" description="The bounding rectangle of the window.">
				<cocoa key="boundsAsQDRect"/>
			</property>
			<property name="closeable" code="hclb" type="boolean" access="r" description="Does the window have a close button?">
				<cocoa key="hasCloseBox"/>
			</property>
			<property name="miniaturizable" code="ismn" type="boolean" access="r" description="Does the window have a minimize button?">
				<cocoa key="isMiniaturizable"/>
			</property>
			<property name="miniaturized" code="pmnd" type="boolean" description="Is the window minimized right now?">
				<cocoa key="isMiniaturized"/>
			</property>
			<property name="resizable" code="prsz" type="boolean" access="r" description="Can the window be resized?">
				<cocoa key="isResizable"/>
			</property>
			<property name="visible" code="pvis" type="boolean" description="Is the window visible right now?">
				<cocoa key="isVisible"/>
			</property>
			<property name="zoomable" code="iszm" type="boolean" access="r" description="Does the window have a zoom button?">
				<cocoa key="isZoomable"/>
			</property>
			<property name="zoomed" code="pzum" type="boolean" description="Is the window zoomed right now?">
				<cocoa key="isZoomed"/>
			</property>
			<responds-to command="close">
				<cocoa method="handleCloseScriptCommand:"/>
			</responds-to>
		</class>
	</suite>

	<suite name="Artemis Suite" code="ArtS" description="Spaces, tabs and the pages in them.">
		<enumeration name="window mode" code="ArME">
			<enumerator name="normal" code="ArNo" description="A browser window."/>
			<enumerator name="incognito" code="ArIn" description="An incognito window: nothing it opens is saved."/>
			<enumerator name="scout" code="ArSc" description="A Scout window holding one page."/>
		</enumeration>
		<enumeration name="tab location" code="ArLE">
			<enumerator name="favorite" code="ArFv" description="A favorite, shared by every space of its profile."/>
			<enumerator name="pinned" code="ArPn" description="A pinned tab."/>
			<enumerator name="unpinned" code="ArUp" description="A tab in Today."/>
		</enumeration>

		<class-extension extends="application">
			<element type="space" access="r">
				<cocoa key="scriptSpaces"/>
			</element>
			<element type="tab" access="r" description="Every tab: favorites, then each space's tabs.">
				<cocoa key="scriptTabs"/>
			</element>
		</class-extension>

		<class-extension extends="window">
			<property name="active tab" code="ArAT" type="tab" access="r" description="The page the window is showing.">
				<cocoa key="scriptActiveTab"/>
			</property>
			<property name="active space" code="ArAS" type="space" description="The space the window is showing. Set it to switch spaces.">
				<cocoa key="scriptActiveSpace"/>
			</property>
			<property name="mode" code="ArMd" type="window mode" access="r" description="Normal, incognito or Scout.">
				<cocoa key="scriptMode"/>
			</property>
			<element type="tab" access="r" description="The favorites and the tabs of the active space.">
				<cocoa key="scriptTabs"/>
			</element>
			<element type="space" access="r">
				<cocoa key="scriptSpaces"/>
			</element>
		</class-extension>

		<class name="space" code="ArSp" description="A space: its own pinned and Today tabs.">
			<cocoa class="ArtemisScriptSpace"/>
			<property name="id" code="ID  " type="text" access="r" description="The unique identifier of the space.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" description="The name of the space."/>
			<property name="title" code="ArTi" type="text" access="r" description="The name of the space.">
				<cocoa key="name"/>
			</property>
			<property name="profile" code="ArPf" type="text" access="r" description="The name of the profile the space browses as.">
				<cocoa key="profileName"/>
			</property>
			<property name="locked" code="ArLk" type="boolean" access="r" description="Is the space locked? A locked space shows scripts no tabs.">
				<cocoa key="isLocked"/>
			</property>
			<element type="tab" access="r">
				<cocoa key="scriptTabs"/>
			</element>
			<responds-to command="focus">
				<cocoa method="handleFocusScriptCommand:"/>
			</responds-to>
		</class>

		<class name="tab" code="ArTb" description="A tab.">
			<cocoa class="Artemis.BrowserTab"/>
			<property name="id" code="ID  " type="text" access="r" description="The unique identifier of the tab.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="title" code="ArTi" type="text" access="r" description="The name the sidebar shows for the tab.">
				<cocoa key="scriptTitle"/>
			</property>
			<property name="URL" code="URL " type="text" description="The page's address. Set it to load a new page.">
				<cocoa key="scriptURL"/>
			</property>
			<property name="loading" code="ArLd" type="boolean" access="r" description="Is the page still loading?">
				<cocoa key="scriptLoading"/>
			</property>
			<property name="location" code="ArLc" type="tab location" access="r" description="Favorite, pinned or unpinned.">
				<cocoa key="scriptLocation"/>
			</property>
			<property name="muted" code="ArMu" type="boolean" description="Is the tab's sound muted?">
				<cocoa key="scriptMuted"/>
			</property>
			<responds-to command="close">
				<cocoa method="handleCloseScriptCommand:"/>
			</responds-to>
			<responds-to command="select">
				<cocoa method="handleSelectScriptCommand:"/>
			</responds-to>
			<responds-to command="reload">
				<cocoa method="handleReloadScriptCommand:"/>
			</responds-to>
			<responds-to command="stop">
				<cocoa method="handleStopScriptCommand:"/>
			</responds-to>
			<responds-to command="go back">
				<cocoa method="handleGoBackScriptCommand:"/>
			</responds-to>
			<responds-to command="go forward">
				<cocoa method="handleGoForwardScriptCommand:"/>
			</responds-to>
			<responds-to command="execute">
				<cocoa method="handleExecuteScriptCommand:"/>
			</responds-to>
		</class>

		<command name="select" code="ArtSslct" description="Show a tab in its window, switching space if needed.">
			<direct-parameter type="tab"/>
		</command>
		<command name="focus" code="ArtSfocs" description="Switch the front browser window to a space.">
			<direct-parameter type="space"/>
		</command>
		<command name="reload" code="ArtSrelo" description="Reload a tab.">
			<direct-parameter type="tab"/>
		</command>
		<command name="stop" code="ArtSstop" description="Stop loading a tab.">
			<direct-parameter type="tab"/>
		</command>
		<command name="go back" code="ArtSback" description="Go back in a tab's history.">
			<direct-parameter type="tab"/>
		</command>
		<command name="go forward" code="ArtSfwrd" description="Go forward in a tab's history.">
			<direct-parameter type="tab"/>
		</command>
		<command name="execute" code="ArtSexec" description="Run JavaScript in a tab's page and return its result. Needs Settings → Privacy → Allow JavaScript from Apple Events.">
			<direct-parameter type="tab"/>
			<parameter name="javascript" code="ArJS" type="text" description="The JavaScript to run.">
				<cocoa key="JavaScript"/>
			</parameter>
			<result type="any" description="The value of the last expression."/>
		</command>
	</suite>
</dictionary>
