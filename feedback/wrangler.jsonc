{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artemis-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "feedback.artemisbrowser.app", "custom_domain": true },
  ],
  "kv_namespaces": [
    { "binding": "SIGS", "id": "9ec2c3c6b0514771ab342c96032f6daa" },
  ],
  "ratelimits": [
    {
      "name": "ADDRESS_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 },
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "vars": {
    "PUBLIC_REPO": "artemisbrowser/artemis",
    "PRIVATE_REPO": "artemisbrowser/artemis-feedback",
  },
  "observability": { "enabled": true },
}
