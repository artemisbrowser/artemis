{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artemis-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "feedback.artemisbrowser.app", "custom_domain": true },
  ],
  "kv_namespaces": [
    // Paste the id printed by `npx wrangler kv namespace create SIGS`.
    { "binding": "SIGS", "id": "REPLACE_WITH_SIGS_NAMESPACE_ID" },
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "ADDRESS_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": { "GITHUB_REPO": "devfindles/artemis-feedback" },
  "observability": { "enabled": true },
}
