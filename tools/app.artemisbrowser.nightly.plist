<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- tools/nightly.sh every five minutes; docs/releasing.md says how to install it -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.artemisbrowser.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>exec /bin/bash "$HOME/Library/Application Support/ArtemisRelease/nightly/tree/tools/nightly.sh"</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
